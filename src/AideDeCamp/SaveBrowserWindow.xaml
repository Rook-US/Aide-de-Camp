<Window x:Class="AideDeCamp.SaveBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Grand Tactician Save" Height="650" Width="980" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#11161C" Foreground="#E8EDF2">
    <Window.Resources>

        <Style TargetType="ListBox"><Setter Property="Background" Value="#151D25"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SELECT SAVE" Foreground="#6FAAB3" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock x:Name="InstallPathText" Foreground="#7E8C99" FontSize="10" Margin="0,3,0,8" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Rescan" Click="Rescan_Click" VerticalAlignment="Top"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#151D25" BorderBrush="#35424F" BorderThickness="1" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="ACTIVE CAMPAIGNS" Foreground="#8999A7" FontSize="10" Margin="3,0,0,7"/>
                    <ListBox Grid.Row="1" x:Name="CampaignList" SelectionChanged="CampaignList_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding RelativePath}" Foreground="#788796" FontSize="9"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" Background="#26313C" HorizontalAlignment="Stretch"/>
            <Border Grid.Column="2" Background="#151D25" BorderBrush="#35424F" BorderThickness="1" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="SAVES" Foreground="#8999A7" FontSize="10" Margin="3,0,0,7"/>
                    <ListBox Grid.Row="1" x:Name="SaveList" MouseDoubleClick="SaveList_MouseDoubleClick">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="5,6"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding DetailText}" Foreground="#8FA0AE"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="#8C9AA7" Text="Select a campaign, then choose the save to edit."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Browse Folder…" Click="Browse_Click"/><Button Content="Cancel" IsCancel="True"/><Button Content="Open Selected" IsDefault="True" Click="OpenSelected_Click" Background="#31515A"/></StackPanel>
        </Grid>
    </Grid>
</Window>
