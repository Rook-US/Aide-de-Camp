<Window x:Class="AideDeCamp.NamingSchemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Naming Scheme" Height="820" Width="1180" MinHeight="650" MinWidth="980"
        Background="#11161C" Foreground="#E8EDF2">
    <Window.Resources>



        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#8E9AA7"/><Setter Property="FontSize" Value="11"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="NAMING RULES" FontWeight="Bold" Foreground="#93A1AE" Margin="4,2,4,8"/>
                <ListBox Grid.Row="1" x:Name="RuleList" DisplayMemberPath="Name" Background="#111820" BorderBrush="#303C47" SelectionChanged="RuleList_SelectionChanged"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"><Button Content="New" Click="NewRule_Click"/><Button Content="Delete" Click="DeleteRule_Click"/></StackPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#2C3741"/>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,0,6,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CUSTOM NAMING RULE" FontSize="17" FontWeight="Bold"/><TextBlock Text="Build the name by arranging tokens. Custom text preserves spaces exactly as typed." Foreground="#7F8C98" Margin="0,3,0,10"/></StackPanel>
                    <Button Grid.Column="1" Content="Save Rules" Click="SaveRules_Click" VerticalAlignment="Top"/>
                </Grid>

                <Border Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Rule Name" Style="{StaticResource Label}"/><TextBox x:Name="RuleNameBox" Margin="0,4,0,0" TextChanged="RuleField_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Unit Type" Style="{StaticResource Label}"/><ComboBox x:Name="UnitTypeCombo" Margin="0,4,0,0" SelectionChanged="RuleField_Changed"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Unit Tier (optional)" Style="{StaticResource Label}"/><ComboBox x:Name="UnitTierCombo" Margin="0,4,0,0" SelectionChanged="RuleField_Changed"/></StackPanel>
                    </Grid>
                </Border>

                <Border Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="Faction, weapon, state and preservation filters…" Click="Filters_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/><TextBlock Text="NAME LAYOUT" FontWeight="Bold" Foreground="#93A1AE"/>
                        <TextBlock Text="Drag the blocks to reorder them. Up/Down buttons provide the same control." Foreground="#71808E" FontSize="10" Margin="0,2,0,7"/>
                        <WrapPanel Margin="0,0,0,7">
                            <Button Content="+ Number" Tag="Number" Click="AddToken_Click"/>
                            <Button Content="+ Home State" Tag="HomeState" Click="AddToken_Click"/>
                            <Button Content="+ Unit Type" Tag="UnitType" Click="AddToken_Click"/>
                            <Button Content="+ Unit Tier" Tag="UnitTier" Click="AddToken_Click"/>
                            <TextBox x:Name="CustomTextBox" Width="150" Margin="8,3,2,3" ToolTip="Spaces are preserved exactly."/>
                            <Button Content="+ Custom Text" Click="AddCustomText_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="TokenList" Height="100" AllowDrop="True" Background="#111820" BorderBrush="#303C47"
                                 PreviewMouseLeftButtonDown="TokenList_PreviewMouseLeftButtonDown" PreviewMouseMove="TokenList_PreviewMouseMove" Drop="TokenList_Drop" SelectionChanged="TokenList_SelectionChanged">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><Border Background="#26313C" BorderBrush="#50606E" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="4"><TextBlock Text="{Binding DisplayLabel}"/></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="◀ Move Left" Click="MoveTokenLeft_Click"/><Button Content="Move Right ▶" Click="MoveTokenRight_Click"/><Button Content="Remove" Click="RemoveToken_Click"/>
                            <TextBlock Text="Selected text:" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="15,0,5,0"/>
                            <TextBox x:Name="SelectedTokenTextBox" Width="180" IsEnabled="False" TextChanged="SelectedTokenTextBox_TextChanged" ToolTip="For Custom Text tokens only. Spaces are literal."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Number Style" Style="{StaticResource Label}"/><ComboBox x:Name="NumberStyleCombo" Margin="0,4,0,0" SelectionChanged="RuleField_Changed"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Home State Style" Style="{StaticResource Label}"/><ComboBox x:Name="StateStyleCombo" Margin="0,4,0,0" SelectionChanged="RuleField_Changed"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Case" Style="{StaticResource Label}"/><ComboBox x:Name="CaseStyleCombo" Margin="0,4,0,0" SelectionChanged="RuleField_Changed"/></StackPanel>
                        </Grid>
                        <CheckBox x:Name="GappedNumberingCheck" Content="Renumber with gaps" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" Checked="RuleField_Changed" Unchecked="RuleField_Changed"/>
                        <TextBlock Text="Reassign matching units from low available numbers, with occasional small skips. Preview stays stable; excluded units and reserved numbers are respected. Unchecked preserves existing numbers." TextWrapping="Wrap" Foreground="#AAB8C5" Margin="0,4,0,0"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Unit Type Override" Style="{StaticResource Label}"/><TextBox x:Name="UnitTypeOverrideBox" Margin="0,4,0,0" TextChanged="RuleField_Changed" ToolTip="Example: Inf, INF, Infanterie. Blank uses the normal unit type label."/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Unit Tier Override" Style="{StaticResource Label}"/><TextBox x:Name="UnitTierOverrideBox" Margin="0,4,0,0" TextChanged="RuleField_Changed" ToolTip="Example: REG, Regiment, Infanterie-Brigade. Blank uses the tier name."/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="RESERVED / SKIPPED NUMBERS" FontWeight="Bold" Foreground="#93A1AE"/><TextBlock Text="Comma separated; ranges are accepted. Example: 4, 13, 20-25" Style="{StaticResource Label}" Margin="0,3,0,5"/><TextBox x:Name="SkippedNumbersBox" TextChanged="RuleField_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="SPECIAL NAMES" FontWeight="Bold" Foreground="#93A1AE"/><TextBlock Text="5 or 5th both mean numeral 5. A special name consumes that numeral." Style="{StaticResource Label}" Margin="0,3,0,5"/>
                            <DataGrid x:Name="SpecialNamesGrid" Height="125" AutoGenerateColumns="False" CanUserAddRows="True" Background="#111820" Foreground="#E8EDF2" RowBackground="#172029" CellEditEnding="SpecialNamesGrid_CellEditEnding">
                                <DataGrid.Columns><DataGridTextColumn Header="NUMBER" Binding="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridTextColumn Header="CUSTOM NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#0F171E" BorderBrush="#46606E" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><ComboBox x:Name="PreviewFactionCombo" Width="230" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="RuleField_Changed"><ComboBoxItem Content="Current faction — Preview / Apply"/><ComboBoxItem Content="Union — Preview / Apply"/><ComboBoxItem Content="Confederacy — Preview / Apply"/><ComboBoxItem Content="Both — Preview / Apply"/></ComboBox><TextBlock Text="LIVE PREVIEW" FontWeight="Bold" Foreground="#7EAAB2"/><TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="18" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="PreviewSequenceText" FontFamily="Consolas" Foreground="#8A98A5" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShowSpacesCheck" Content="Show spaces ·" VerticalAlignment="Top" Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"/>
                    </Grid>
                </Border>

                <Border Background="#171F27" BorderBrush="#303C47" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="MASS RENAME" FontWeight="Bold" Foreground="#93A1AE"/><TextBlock x:Name="MatchSummaryText" Foreground="#7F8C98" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Preview Rename" Click="PreviewRename_Click"/><Button Content="Apply to Working State" Click="ApplyRename_Click"/></StackPanel>
                        </Grid>
                        <DataGrid x:Name="RenamePreviewGrid" Height="180" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" Background="#111820" Foreground="#E8EDF2" RowBackground="#172029">
                            <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding AssignedNumber}" Width="45"/><DataGridTextColumn Header="OLD NAME" Binding="{Binding OldName}" Width="*"/><DataGridTextColumn Header="NEW NAME" Binding="{Binding NewName}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding TypeName}" Width="85"/><DataGridTextColumn Header="TIER" Binding="{Binding TierName}" Width="90"/><DataGridTextColumn Header="HOME" Binding="{Binding HomeState}" Width="100"/></DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Expander Header="Preserved / skipped — reasons"><TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="NoWrap" Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
